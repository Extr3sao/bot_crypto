        "requirement": "profit factor >= 1.10",
        "relation": "tightens c3 (which requires > 1.0)"
      },
      {
        "id": "PG-4",
        "requirement": "sufficient OOS sample per the applicable contract",
        "relation": "inherits c1 (>= 100 total, >= 30 OOS)"
      },
      {
        "id": "PG-5",
        "requirement": "chronological validation across distinct periods",
        "relation": "inherits c5 + walk-forward"
      },
      {
        "id": "PG-6",
        "requirement": "lower confidence bound of expectancy > 0 under serial dependence",
        "relation": "new (block bootstrap / HAC; never an i.i.d. t-test)"
      },
      {
        "id": "PG-7",
        "requirement": "1.5x cost stress remains positive",
        "relation": "tightens c7 (PF > 0.9 at 2x); both run"
      },
      {
        "id": "PG-8",
        "requirement": "no risk-engine violations",
        "relation": "new"
      },
      {
        "id": "PG-9",
        "requirement": "no excessive dependence on one trade or one regime",
        "relation": "inherits c8 (no window > 60% of positive net), extended to single-trade dependence"
      },
      {
        "id": "PG-10",
        "requirement": "multiple-testing correction when more than one trial ran",
        "relation": "new"
      },
      {
        "id": "PG-11",
        "requirement": "no look-ahead or PIT violation",
        "relation": "new; enforced mechanically"
      }
    ]
  },
