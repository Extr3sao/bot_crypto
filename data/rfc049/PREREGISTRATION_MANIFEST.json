  "frozen_parameters": {
    "H-049-001": {
      "parameters": {
        "growth_window_days": 30,
        "reference_median_window_days": 365,
        "decision_weekday": "Sunday",
        "decision_time_utc": "23:00:00",
        "execution_lag": "next daily bar open",
        "parameter_searches": 0
      },
      "entry_rule": "Let D_t be the total circulating value in USD of all USD-pegged stablecoins as published by the frozen vendor series (SRC-049-001), on the daily grid. Let r30_t = D_t / D_{t-30} - 1 (30-day net growth). Let B_t be the median of the previous 365 daily values of r30 ending at t-1 (strictly causal; B_t uses no value dated t or later). At each weekly decision instant, using the most recent daily observation t* whose availability time is <= Saturday 23:59:00 UTC, if r30_{t*} > B_{t*} the strategy is LONG; otherwise FLAT. A LONG state is opened at the next bar open after a transition from FLAT.",
      "exit_rule": "The position is closed at the next bar open after the weekly state becomes FLAT (r30 <= B). The runtime risk engine may close the position independently and unconditionally; the strategy has no discretionary stop, no target and no time stop beyond the state flip."
    },
    "H-049-002": {
      "parameters": {
        "liquidity_change_window_weeks": 4,
        "decision_weekday": "Sunday",
        "decision_time_utc": "23:00:00",
        "execution_lag": "next daily bar open",
        "parameter_searches": 0
      },
      "entry_rule": "Let NL_t = WALCL_t - RRP_t - TGA_t where WALCL_t is the Federal Reserve total assets (Wednesday level), RRP_t is the overnight reverse repo amount and TGA_t is the Treasury General Account (Wednesday level), all in USD billions, aligned to the weekly Wednesday grid using each series' most recent observation on or before that Wednesday. At each weekly decision instant, use the most recent complete Wednesday snapshot whose inputs were all published on or before Saturday 23:59:00 UTC (declared release lags: WALCL and TGA at least 1 day after the Wednesday reference; RRP at least 1 business day). If NL_w - NL_{w-4} > 0 the strategy is LONG; otherwise FLAT. A LONG state is opened at the next bar open after a transition from FLAT.",
      "exit_rule": "The position is closed at the next bar open after the weekly state becomes FLAT (4-week net-liquidity change <= 0). The runtime risk engine may close the position independently and unconditionally; the strategy has no discretionary stop, no target and no time stop beyond the state flip."
    }
  },
