  "scheduler_lifecycle": {
    "after_the_close": "every later tick is an idempotent no-op: no sample, no artefact rewrite, no run event; the consolidation stays byte-identical across repetitions and across a simulated restart",
    "at_the_close": "the ended branch returns EXIT_PERIOD_ENDED before any statement that could collect, re-derived from the tick's syntax tree by closure_guard_structure and replayed; the consolidation is written once, with the metrics consolidated, the missed windows named, the verifiers delegated and the terminal state declared",
    "before_the_close": "the tick takes the shared lease, consults the local slot state first and makes no market request when the slot is already observed",
    "no_admin_dependency": true,
    "other_programs_tasks_touched": false,
    "run_log_provenance": "every run event records the launch mode it declares, so a reader can separate the task's own ticks from manual and verification invocations; the events written before the field existed carry none and are named as unrecorded rather than rewritten",
    "task_self_expiry": "the task's declared Duration is P30D and expires it on its own",
    "terminal_transition": "the period disables its own task (schtasks /change /tn <own task> /disable) without elevation and without touching another program's task; a failure is recorded in the consolidation rather than raised"
  },
