# ============================================================
# Python estándar
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ============================================================
# Entornos virtuales
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# SECRETOS — NUNCA commitear
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ============================================================
# Datos locales del bot
# ============================================================
data/raw/*
data/processed/*
data/backtests/*
data/storage/*
data/chart_snapshots/*
data/*.db
# WP-EDGE-03 — tienda forward: OHLCV crudo de ~5 MB que crece en cada corrida. Se
# mantiene local por el mismo criterio que los corpus crudos de arriba; lo que SI
# se versiona es su procedencia (INGEST_LEDGER.jsonl) y sus digests, pinados en
# reports/edge-recovery/WP-EDGE-03/forward-observation/OBSERVATION.json#manifest.
data/forward/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/backtests/.gitkeep
!data/storage/.gitkeep

# ============================================================
# Logs y reportes
# ============================================================
*.log
*.out.txt
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# ------------------------------------------------------------
# WP-EDGE-01 — la evidencia de la campana y de la ablacion H1 SI se versiona.
# `reports/*` ignora el ARBOL entero, y git no re-incluye un fichero cuyo
# directorio padre esta excluido: hay que re-incluir la cadena de padres paso a
# paso y volver a ignorar lo de en medio, para que la excepcion alcance solo a
# esta carpeta y no abra de golpe el resto de salidas de reports/.
# ------------------------------------------------------------
!reports/edge-recovery/
reports/edge-recovery/*
!reports/edge-recovery/WP-EDGE-01/
reports/edge-recovery/WP-EDGE-01/*
# Una linea por experimento: la excepcion queda explicita y acotada a la evidencia
# de cada ablacion, no a todo lo que se suelte en la carpeta del WP.
!reports/edge-recovery/WP-EDGE-01/ablation-h1/
!reports/edge-recovery/WP-EDGE-01/risk-budget-h5/
!reports/edge-recovery/WP-EDGE-01/entry-timing-h2/
!reports/edge-recovery/WP-EDGE-01/vol-filter-h4/
!reports/edge-recovery/WP-EDGE-01/retest-h6/
!reports/edge-recovery/WP-EDGE-01/oos-trend-4h/
!reports/edge-recovery/WP-EDGE-01/closure/
# El informe de cierre es un .md en la RAIZ de la carpeta del WP (junto a los
# artefactos de la campana), no dentro de un experimento: se re-incluye por
# extension y solo en ese nivel.
!reports/edge-recovery/WP-EDGE-01/*.md

# ------------------------------------------------------------
# WP-EDGE-02 — misma cadena de excepciones que WP-EDGE-01, por el mismo motivo:
# la evidencia de la robustez de tendencia y de la auditoria de riesgo SI se
# versiona, y cada carpeta de experimento se re-incluye con su propia linea para
# que la excepcion quede acotada a esa evidencia.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-02/
reports/edge-recovery/WP-EDGE-02/*
!reports/edge-recovery/WP-EDGE-02/trend-robustness/
!reports/edge-recovery/WP-EDGE-02/h6-risk-audit/
# La verificacion independiente vive en la raiz de la carpeta del WP, junto a los
# informes: se re-incluye por extension y solo en ese nivel.
!reports/edge-recovery/WP-EDGE-02/*.json
!reports/edge-recovery/WP-EDGE-02/*.md

# ------------------------------------------------------------
# WP-EDGE-03 — misma cadena de excepciones que WP-EDGE-01/02, por el mismo motivo:
# la evidencia de la observacion forward (ingesta incremental, shadow de los
# rulesets congelados y paridad de riesgo) SI se versiona, y cada carpeta de salida
# se re-incluye con su propia linea para que la excepcion quede acotada.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-03/
reports/edge-recovery/WP-EDGE-03/*
!reports/edge-recovery/WP-EDGE-03/forward-observation/
!reports/edge-recovery/WP-EDGE-03/risk-parity/
# La verificacion independiente vive en la raiz de la carpeta del WP, junto a los
# informes: se re-incluye por extension y solo en ese nivel.
!reports/edge-recovery/WP-EDGE-03/*.json
!reports/edge-recovery/WP-EDGE-03/*.md

# ------------------------------------------------------------
# WP-EDGE-04 — misma cadena de excepciones que WP-EDGE-01/02/03: la auditoria del
# runtime, el diseno del scheduler, los informes, la verificacion independiente y
# la instantanea fechada de la evidencia viva SI se versionan. La instantanea
# incluye la publicacion que la evidencia apunta, porque un puntero cuyos
# artefactos se quedan fuera no lo puede comprobar nadie; cada fichero copiado
# lleva su sha256 en evidence/SNAPSHOT.json.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-04/
reports/edge-recovery/WP-EDGE-04/*
!reports/edge-recovery/WP-EDGE-04/evidence/
!reports/edge-recovery/WP-EDGE-04/*.json
!reports/edge-recovery/WP-EDGE-04/*.md

# ------------------------------------------------------------
# WP-EDGE-05 — misma cadena de excepciones que WP-EDGE-01/02/03/04, por el mismo
# motivo: el watchdog independiente, la reconciliacion posterior a un crash, la
# auditoría de continuidad de Windows, el presupuesto de recursos, la verificación
# independiente y la instantánea fechada de la evidencia viva SI se versionan.
# La instantánea (evidence/) lleva la línea temporal, el registro de las dos tareas
# programadas y la rebanada de la tienda, cada uno con su sha256 en
# evidence/SNAPSHOT.json; el estado operativo vivo sigue bajo data/forward/
# (ignorado más arriba), de modo que nada de lo que crece en cada tick entra aquí.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-05/
reports/edge-recovery/WP-EDGE-05/*
!reports/edge-recovery/WP-EDGE-05/evidence/
!reports/edge-recovery/WP-EDGE-05/*.json
!reports/edge-recovery/WP-EDGE-05/*.md

# ------------------------------------------------------------
# WP-EDGE-05R — misma cadena de excepciones que WP-EDGE-01…05, por el mismo motivo:
# el diagnostico de almacenamiento, el registro de la recuperacion, la instantanea de
# lectura, los informes renderizados desde ella, la verificacion independiente, la
# regresion y el estado de GitHub SI se versionan. La instantanea de lectura fija el
# sha256 de cada artefacto del que cita una cifra, y el estado vivo (data/forward/)
# sigue bajo la regla de arriba, de modo que nada que crezca en cada tick entra aqui.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-05R/
reports/edge-recovery/WP-EDGE-05R/*
!reports/edge-recovery/WP-EDGE-05R/*.json
!reports/edge-recovery/WP-EDGE-05R/*.md
!reports/edge-recovery/WP-EDGE-05R/*.jsonl
# ------------------------------------------------------------
# WP-EDGE-06 — misma cadena de excepciones que WP-EDGE-01…05R, por el mismo motivo: el
# diagnostico de almacenamiento, el inventario de los inquilinos del volumen, la auditoria
# economica, las hipotesis registradas ANTES de correr, y los informes SI se versionan.
# `research/` necesita su propia linea: git no re-incluye un fichero cuyo directorio padre
# esta excluido, y esa carpeta es la que lleva la evidencia de las familias nuevas.
# ------------------------------------------------------------
!reports/edge-recovery/WP-EDGE-06/
reports/edge-recovery/WP-EDGE-06/*
!reports/edge-recovery/WP-EDGE-06/*.json
!reports/edge-recovery/WP-EDGE-06/*.md
!reports/edge-recovery/WP-EDGE-06/*.jsonl
!reports/edge-recovery/WP-EDGE-06/research/
reports/edge-recovery/WP-EDGE-06/research/*
!reports/edge-recovery/WP-EDGE-06/research/*.json
!reports/edge-recovery/WP-EDGE-06/research/*.md
!reports/edge-recovery/WP-EDGE-06/research/*.jsonl
!reports/edge-recovery/WP-EDGE-06/research/*.csv
!reports/edge-recovery/WP-EDGE-06/research/*/
reports/edge-recovery/WP-EDGE-06/research/*/*
!reports/edge-recovery/WP-EDGE-06/research/*/*.json
!reports/edge-recovery/WP-EDGE-06/research/*/*.md
!reports/edge-recovery/WP-EDGE-06/research/*/*.csv
!reports/edge-recovery/WP-EDGE-06/research/*/*.jsonl

# ============================================================
# CAP-003 — evidencias OHLCV crudas: locales por tamano.
# El ledger (evidence/real_decisions/*.jsonl) SI se versiona y
# fija cada fichero crudo con su sha256.
# ============================================================
evidence/real_decisions/raw_evidence/

# ============================================================
# CAP-004 — estado operativo vivo (cambia en cada ciclo, no es evidencia)
# El manifiesto, el RAW_EVIDENCE_MANIFEST y los checkpoints SI se versionan.
# ============================================================
evidence/real_decisions/heartbeat.json
evidence/real_decisions/CAMPAIGN_LOCK.json
# CAP-004B — the supervisor's operational history is append-only host state
# (it grows every scheduled run); the campaign ledger remains versioned.
evidence/real_decisions/operations.jsonl

# ============================================================
# Notebooks — solo checkpoints
# ============================================================
notebooks/.ipynb_checkpoints/

