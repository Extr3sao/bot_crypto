# ============================================================
# Python estándar
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ============================================================
# Entornos virtuales
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# SECRETOS — NUNCA commitear
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ============================================================
# Datos locales del bot
# ============================================================
data/raw/*
data/processed/*
data/backtests/*
data/storage/*
data/chart_snapshots/*
data/*.db
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/backtests/.gitkeep
!data/storage/.gitkeep

# ============================================================
# Logs y reportes
# ============================================================
*.log
*.out.txt
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# ============================================================
# CAP-003 — evidencias OHLCV crudas: locales por tamano.
# El ledger (evidence/real_decisions/*.jsonl) SI se versiona y
# fija cada fichero crudo con su sha256.
# ============================================================
evidence/real_decisions/raw_evidence/

# ============================================================
# CAP-004 — estado operativo vivo (cambia en cada ciclo, no es evidencia)
# El manifiesto, el RAW_EVIDENCE_MANIFEST y los checkpoints SI se versionan.
# ============================================================
evidence/real_decisions/heartbeat.json
evidence/real_decisions/CAMPAIGN_LOCK.json
# CAP-004B — the supervisor's operational history is append-only host state
# (it grows every scheduled run); the campaign ledger remains versioned.
evidence/real_decisions/operations.jsonl

# ============================================================
# Notebooks — solo checkpoints
# ============================================================
notebooks/.ipynb_checkpoints/

# ============================================================
# Herramientas / IDEs
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# ============================================================
# Testing / Coverage
# ============================================================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/

# ============================================================
# Docker
# ============================================================
docker-data/

# ============================================================
# Sistema SDD / outputs generados
# ============================================================
.ai/skills/*.tmp

# ============================================================
# Workstream transient commit bodies (`git commit -F <body>`).
# Pino explícito para que `git add -A` accidental nunca trackee
# estos ficheros. CF `.github/workflows/ci.yml` step
# `Forbid tracked transient files` que grep-checka el nombre
# contra `git ls-files` y rompe el build si filtra alguno.
# `*.out.txt` cubría implicitamente algunos pero NO todos
# (`commit_msg.txt`, `commit_msg_cluster1.txt`, etc.) — este
# patrón fijo la convención permanente.
# ============================================================
commit_msg*.txt

# ============================================================
# Worktrees físicos, snapshots y backups del agente —
# NO publicar jamás: son carpetas físicas del PC local, cada
# una apunta a una rama del MISMO repositorio (git worktree).
# Las ramas se publican; estas carpetas NO.
# ============================================================
.worktrees/
.research/
.agentic-backup/
.freebuff/
his.zip

# ============================================================
# TAP-SUPERVISOR-INTEGRATION-002 — this delivery's reports are evidence and are
# versioned; the rest of reports/ stays ignored exactly as main decided. git does
# not re-include a file whose parent is excluded, so the chain is re-opened one
# level at a time and closed again below it.
# ============================================================
!reports/ai-bots/
reports/ai-bots/*
!reports/ai-bots/TAP-SUPERVISOR-INTEGRATION-002/
!reports/ai-bots/TAP-SUPERVISOR-INTEGRATION-002/evidence/*.log
!reports/ai-bots/TAP-SUPERVISOR-INTEGRATION-002/evidence/*.txt

# ============================================================
# TAP-INTEGRATION-GATE-001 — the gate's reports and the evidence it used are the
# delivery. Re-opened one level at a time for the same reason as the 002 block above.
# ============================================================
!reports/ai-bots/TAP-INTEGRATION-GATE-001/
!reports/ai-bots/TAP-INTEGRATION-GATE-001/**
# TAP-INTEGRATION-ADMISSION-002 — the admission audit's report, its independent verifier and
# the PAPER session it judged are the evidence for its verdicts; versioning them is the point.
!reports/ai-bots/TAP-INTEGRATION-ADMISSION-002/
!reports/ai-bots/TAP-INTEGRATION-ADMISSION-002/**
# ...except interpreter byproducts: the blanket negation above out-ranks the
# repo-wide `__pycache__/` rule at line 4 (last match wins), so it is re-closed
# here. The evidence is the verifier's source and the files it judged, not what
# CPython cached while running it.
reports/ai-bots/TAP-INTEGRATION-ADMISSION-002/**/__pycache__/
reports/ai-bots/TAP-INTEGRATION-ADMISSION-002/**/*.pyc
