        from trading_bot.strategies.types import Signal
    
        broker = PaperBroker(equity=10_000.0)
        risk = RiskManager(risk=_risk_settings(), equity=10_000.0)
    
        class _Snap:
            symbol = "SOL/USDT"
            last_price = 100.0
    
